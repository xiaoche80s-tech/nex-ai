<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.gkht.ai</groupId>
        <artifactId>nexai</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>nexai-module-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        NexAI 智能体平台模块：基于 agentscope-java v2 库嵌入（ADR-0001）的对外产品化多租户智能体平台。
        七聚合垂直切分（agentspec、channel、skill、mcpserver、session、audit、usage），每个聚合按 DDD Convention B 结构组织。
    </description>

    <dependencies>
        <!-- 业务组件 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- AI 智能体运行时：agentscope-java v2（库嵌入，ADR-0001；版本经 nexai-dependencies 的
             agentscope-bom 管理）。使用面：模型构造（连通性探测与运行时装配）
             + 运行时基座 HarnessAgent（workspace/沙箱/子代理/记忆/转录）
             + 会话状态存储（PostgresAgentStateStore，注入容器 DataSource） -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-anthropic</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-gemini</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-postgresql</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- PG 测试驱动：AgentRuntimeGateway 接缝测试直连真实 PostgreSQL（BasePgDbAndRedisUnitTest） -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
