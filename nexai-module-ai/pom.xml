<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.gkht.ai</groupId>
        <artifactId>nexai</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>nexai-module-ai</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>
        NexAI 智能体平台模块：基于 agentscope-java v2 库嵌入（ADR-0001）构建的多租户智能体平台。
        聚合垂直切分（feedback、model、agentspec、session 等），每个聚合按 DDD Convention B 结构组织。
    </description>

    <dependencies>
        <!-- 业务组件 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-biz-tenant</artifactId>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-mybatis</artifactId>
        </dependency>

        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- Test 测试相关 -->
        <dependency>
            <groupId>com.gkht.ai</groupId>
            <artifactId>nexai-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>
